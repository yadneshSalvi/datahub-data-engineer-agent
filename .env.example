# Copy to .env and fill in. Only OPENAI_API_KEY is required to run the agent.
OPENAI_API_KEY=

# Everything below is optional — leave it commented out to use the defaults shown.
# Uncommenting a line with an EMPTY value overrides the default with an empty string.

# DATAHUB_GMS_URL=http://localhost:8081     # note: 8081, not the documented 8080
# DATAHUB_UI_URL=http://localhost:9002
# ONCALL_AGENT_MODEL=gpt-5.6-sol
# ONCALL_MAX_TURNS=40
# ONCALL_PLATFORM=oncall
# ONCALL_NAME_PREFIX=oncall_demo.
# ONCALL_FRONTEND_URL=http://localhost:3001
# ONCALL_DB=./data/oncall.db
# ONCALL_MCP_ENABLED=true

# Optional: real Slack notifications. Unset -> the agent renders the message and records it
# under examples/notifications/ instead.
# SLACK_WEBHOOK_URL=
